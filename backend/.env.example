YTA_HOST=127.0.0.1
YTA_PORT=8000
YTA_OLLAMA_BASE_URL=http://127.0.0.1:11434
YTA_OLLAMA_MODEL=mistral:7b
YTA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
